# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Videos pesados: usar Cloudinary en producción, no subir a git
/public/*.mp4

# Instrucciones para agentes de IA que `next dev` escribe SOLO desde la 16.3.
# No son del proyecto y se vuelven a generar cada vez que se levanta el
# servidor, así que trackearlas solo ensuciaría el historial. La documentación
# de este proyecto es MANUAL.md.
/AGENTS.md
/CLAUDE.md
